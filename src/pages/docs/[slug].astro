---
import {render} from 'astro:content'
import 'github-markdown-css/github-markdown-light.css'
import ScreenCornerLink from '../../components/ScreenCornerLink.astro'
import Sidebar from '../../components/Sidebar.astro'
import Base from '../../layouts/Base.astro'
import {getChapters} from '../../lib/chapters'
import {withBase} from '../../lib/paths'

export async function getStaticPaths() {
  const chapters = await getChapters()
  return chapters.map(({chapter, entry}) => ({
    params: {slug: chapter.slug},
    props: {chapter, entry}
  }))
}

const {chapter, entry} = Astro.props
const {Content} = await render(entry)
---

<Base title={chapter.seo.title} canonicalUrl={chapter.seo.canonicalUrl}>
  <div class="docs">
    <Sidebar type="document" />
    <main class="docs__main">
      <div class="markdown-body">
        <Content />
      </div>
    </main>
    <ScreenCornerLink
      kind="screen"
      text="Slideshow"
      href={withBase(chapter.paths.slideshow)}
    />
  </div>
</Base>

<style>
  .docs {
    display: flex;
    align-items: flex-start;
  }

  .docs__main {
    flex: 1;
    min-width: 0;
  }

  .markdown-body {
    max-width: 960px;
    margin: auto;
    padding: 32px 64px 64px;
  }
</style>
